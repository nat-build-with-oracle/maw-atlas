#!/bin/zsh
# Vault Scanner.app launcher — starts the Bun ψ-vault-scanner server (if not
# already running) and opens it in the default browser. LSUIElement=true → no Dock icon.
APP_DIR="/opt/Code/github.com/Soul-Brews-Studio/atlas-discord-backfill-oracle/vault-scanner"
PORT="${VAULT_SCANNER_PORT:-47711}"
export PATH="/opt/homebrew/bin:$HOME/.bun/bin:/usr/local/bin:$PATH"

if ! curl -s -o /dev/null --max-time 1 "http://localhost:$PORT/api/stats"; then
  nohup bun "$APP_DIR/server.ts" > /tmp/vault-scanner-app.log 2>&1 &
  for i in {1..50}; do
    curl -s -o /dev/null --max-time 1 "http://localhost:$PORT/api/stats" && break
    sleep 0.2
  done
fi
open "http://localhost:$PORT"
